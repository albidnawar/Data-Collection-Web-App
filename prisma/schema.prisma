// Prisma schema for the Fieldlenz Photo Collection App.
// See plan: C:\Users\User\.claude\plans\need-to-make-a-purring-gray.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadStatus {
  pending
  uploading
  uploaded
  failed
}

enum PhotoKind {
  posm
  category
  sku
  outlet
}

// A rep's account role. "pran" reps get the same capture flow as any other
// rep, but must additionally capture an outlet outside photo and name once
// per outlet visit before saving any SKU/POSM/category photo (see
// Rep.role and PhotoRecord.outletName). isAdmin is kept in sync with this
// (true only for role "admin") so existing admin-gating code can keep
// reading it unchanged.
enum RepRole {
  rep
  admin
  pran
}

// For "pran" reps only: whether a POSM/category/SKU photo is of Pran's own
// display or a competitor's, so admins can track Pran's displays against the
// competition outlet by outlet (see PhotoRecord.pranRelation).
enum PranRelation {
  pran
  competitor
}

model Rep {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  isAdmin      Boolean  @default(false)
  role         RepRole  @default(rep)
  createdAt    DateTime @default(now())

  createdBrands      Brand[]       @relation("BrandCreatedBy")
  createdCategories  Category[]    @relation("CategoryCreatedBy")
  createdPosmTypes   PosmType[]    @relation("PosmTypeCreatedBy")
  createdSkuTypes    SkuType[]     @relation("SkuTypeCreatedBy")
  createdShopTypes   ShopType[]    @relation("ShopTypeCreatedBy")
  createdOutlets     Outlet[]      @relation("OutletCreatedBy")
  photoRecords       PhotoRecord[]
  attendances        Attendance[]
}

model Brand {
  id                        String   @id @default(uuid())
  name                      String   @unique
  driveFolderId             String?
  badExecutionDriveFolderId String?
  active                    Boolean  @default(true)
  createdAt     DateTime @default(now())
  createdById   String?
  createdBy     Rep?     @relation("BrandCreatedBy", fields: [createdById], references: [id])

  photoRecords PhotoRecord[]
  outlets      Outlet[]
}

// A physical retail location to visit for a given brand, pinned on the rep-facing
// map. Imported in bulk from a CSV (outlet code + lat/long) against one brand per
// upload -- re-uploading the same code under a different brand's sheet re-tags it,
// since an outlet belongs to exactly one brand at a time.
model Outlet {
  id          String   @id @default(uuid())
  code        String   @unique
  town        String
  lat         Float
  lng         Float
  active      Boolean  @default(true)
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Rep?     @relation("OutletCreatedBy", fields: [createdById], references: [id])

  @@index([brandId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Rep?     @relation("CategoryCreatedBy", fields: [createdById], references: [id])

  photoRecords PhotoRecord[]
}

model PosmType {
  id          String   @id @default(uuid())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Rep?     @relation("PosmTypeCreatedBy", fields: [createdById], references: [id])

  photoRecords PhotoRecord[]
}

model SkuType {
  id          String   @id @default(uuid())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Rep?     @relation("SkuTypeCreatedBy", fields: [createdById], references: [id])

  photoRecords PhotoRecord[]
}

model ShopType {
  id          String   @id @default(uuid())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   Rep?     @relation("ShopTypeCreatedBy", fields: [createdById], references: [id])

  photoRecords PhotoRecord[]
}

model PhotoRecord {
  id            String       @id @default(uuid())
  clientQueueId String       @unique

  repId String
  rep   Rep    @relation(fields: [repId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  kind PhotoKind

  isGoodExecution Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  posmTypeId String?
  posmType   PosmType? @relation(fields: [posmTypeId], references: [id])

  skuTypeId String?
  skuType   SkuType? @relation(fields: [skuTypeId], references: [id])

  shopTypeId String
  shopType   ShopType @relation(fields: [shopTypeId], references: [id])

  shopName String?

  // Free-text outlet name, captured once per outlet visit by reps with
  // Rep.role "pran" and carried onto every photo taken at that outlet
  // (including the outlet's own outside/storefront photo, kind "outlet").
  outletName String?

  // Set only on POSM/category/SKU photos from "pran" reps — whether this
  // specific photo is of Pran's own display or a competitor's. Null for the
  // outlet's own outside photo (kind "outlet") and for non-"pran" reps.
  pranRelation PranRelation?

  gpsLat  Float?
  gpsLng  Float?
  address String?

  surroundingRemarks String?
  otherRemarks       String?
  shelfVacancy       Boolean?

  capturedAt DateTime
  uploadedAt DateTime?

  filename            String
  driveFileId         String?
  driveFileUrl        String?
  filenameSyncPending Boolean @default(false)

  status       UploadStatus @default(pending)
  errorMessage String?

  // Set once the Drive file's actual bytes have been verified (and fixed, if
  // they turned out to be HEIC mislabeled as JPEG) by the admin "Fix
  // corrupted photos" tool. Left null for anything not yet checked, so a
  // batch-fix run can resume from wherever a previous run left off.
  byteFormatCheckedAt DateTime?

  // Set when that check found a problem it couldn't auto-fix (not JPEG, not
  // HEIC, or the Drive download/conversion itself failed). Cleared once a
  // later run confirms the file is fine, so a non-null value here always
  // means "still needs attention" and keeps getting retried.
  byteFormatIssue String?

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([repId])
  @@index([status])
  @@index([capturedAt])
  @@index([filenameSyncPending])
  @@index([isGoodExecution])
  @@index([kind])
  @@index([byteFormatCheckedAt])
  @@index([byteFormatIssue])
  @@index([pranRelation])
  @@index([outletName])
}

// One row per rep per day. dateKey is a "YYYY-MM-DD" string computed in the
// reps' local (Asia/Dhaka) time, so the day boundary lands at their actual
// midnight rather than server UTC midnight.
model Attendance {
  id      String @id @default(uuid())
  repId   String
  rep     Rep    @relation(fields: [repId], references: [id])
  dateKey String

  clockInAt          DateTime
  clockInLat         Float?
  clockInLng         Float?
  clockInAddress     String?
  clockInDriveFileId String?
  clockInPhotoUrl    String?

  clockOutAt          DateTime?
  clockOutLat         Float?
  clockOutLng         Float?
  clockOutAddress     String?
  clockOutDriveFileId String?
  clockOutPhotoUrl    String?

  createdAt DateTime @default(now())

  @@unique([repId, dateKey])
  @@index([dateKey])
}
