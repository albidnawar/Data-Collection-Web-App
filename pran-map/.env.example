# Copy to .env.local for local dev. Never commit the real values.

# Base URL of the main Fieldlenz/CamTag app (its Vercel production URL, e.g.
# https://camtag.vercel.app or a custom domain). This app's server routes call
# that app's /api/pran-map/* endpoints — never the browser directly.
MAIN_APP_URL=""

# Must match PRAN_MAP_API_KEY in the main app's environment. Sent as the
# x-pran-map-key header on every server-to-server call to it.
PRAN_MAP_API_KEY=""

# Password typed once to unlock this map (stored as a signed cookie after
# that — see src/lib/auth.ts). Anyone with this password can see every
# outlet's Pran and competitor execution data, so keep it out of chat/email
# and rotate it if it leaks.
MAP_PASSWORD=""

# Secret used to sign/verify the unlock cookie above. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=""
