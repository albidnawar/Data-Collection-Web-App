# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection strings.
# Local dev: run `npx prisma dev --name fieldlenz --detach` and use the TCP URL it prints for both.
# Production: Neon's pooled connection string (DATABASE_URL) and direct/unpooled string
# (DIRECT_DATABASE_URL, used as the migration shadow database).
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# NextAuth session encryption secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Credentials for the first admin rep created by `prisma db seed`.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""

# Google Drive access via OAuth (personal Gmail accounts don't grant service accounts
# any storage quota, so the app authorizes as the Drive account owner instead).
# 1. Create an OAuth client ID (Desktop app type) in Google Cloud Console and put its
#    id/secret below.
# 2. Run `node scripts/get-drive-refresh-token.mjs` and complete the one-time consent —
#    it prints GOOGLE_OAUTH_REFRESH_TOKEN and DRIVE_ROOT_FOLDER_ID for you to paste in.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
DRIVE_ROOT_FOLDER_ID=""
