# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection strings.
# Local dev: run `npx prisma dev --name fieldlenz --detach` and use the TCP URL it prints for both.
# Production: Neon's pooled connection string (DATABASE_URL) and direct/unpooled string
# (DIRECT_DATABASE_URL, used as the migration shadow database).
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# NextAuth session encryption secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Credentials for the first admin rep created by `prisma db seed`.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""

# Google Drive access via OAuth (personal Gmail accounts don't grant service accounts
# any storage quota, so the app authorizes as the Drive account owner instead).
# 1. Create an OAuth client ID (Desktop app type) in Google Cloud Console and put its
#    id/secret below.
# 2. Run `node scripts/get-drive-refresh-token.mjs` and complete the one-time consent —
#    it prints GOOGLE_OAUTH_REFRESH_TOKEN and DRIVE_ROOT_FOLDER_ID for you to paste in.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
DRIVE_ROOT_FOLDER_ID=""

# Extra confirmation password required in the admin UI to permanently delete a tag
# together with every photo tagged with it (not just merge/reassign them).
TAG_HARD_DELETE_PASSWORD=""

# Optional: set to "true" to skip the forced attendance clock-in gate before reaching
# the capture screen. Leave unset in production — only used for demo/sandbox environments.
DISABLE_ATTENDANCE_GATE=""

# Optional: demo/sandbox mode. When DEMO_MODE is "true", every request without a
# session is silently signed in as the rep named below instead of showing the
# login form, and a one-time guided tour runs across the capture screen and the
# admin dashboard. NEXT_PUBLIC_DEMO_MODE must be set to the same value — it's
# the client-side flag the guided tour checks. Leave all four unset in production.
DEMO_MODE=""
NEXT_PUBLIC_DEMO_MODE=""
DEMO_USERNAME=""
DEMO_PASSWORD=""

# Optional: password for the public, read-only /overview page (stat cards, upload
# trend, top brands/shop types — no per-photo detail, no links into /admin).
# Anyone with the link and this password can view it; no account needed. Leave
# unset to disable the page entirely.
OVERVIEW_PASSWORD=""

# Google Maps JavaScript API key for the rep-facing outlet map (/map). A separate
# credential/product from the Drive OAuth client above — needs its own Google Cloud
# project with billing enabled and the Maps JavaScript API turned on (Google requires
# billing even to stay within the free monthly map-load allowance). Restrict the key
# to your domain(s) via HTTP referrer restrictions. This is a NEXT_PUBLIC_ var because
# the Maps JS API loads in the browser — that's expected, not a leaked secret; the
# referrer restriction is what actually protects it. Leave unset and the map page
# shows a "not configured" message instead of crashing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
